# 开发环境默认走 Vue CLI 代理，代理目标为 http://127.0.0.1:8088
VUE_APP_API_URL=
VUE_APP_CROSS_DOMAIN=false
VUE_APP_HOME_PAGE=/home
VUE_APP_NAME=Go 协同项目管理系统
VUE_APP_BUILD_PATH=/
VUE_APP_DEV_HOST=127.0.0.1
VUE_APP_DEV_PORT=8080

# 如果前后端部署在不同域名，再填写完整 API 地址并打开跨域。
# VUE_APP_API_URL=https://api.example.com
# VUE_APP_CROSS_DOMAIN=true
# VUE_APP_WS_URI=
