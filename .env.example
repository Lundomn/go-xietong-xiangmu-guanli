# Required for docker-compose.deploy.yaml. Use long random values in real deployments.
MS_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MS_MYSQL_USER=root
# When using the root account locally, keep this equal to MS_MYSQL_ROOT_PASSWORD.
MS_MYSQL_PASSWORD=replace-with-a-long-random-password
MS_MYSQL_DATABASE=msproject

MS_JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
MS_JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
MS_REDIS_PASSWORD=

# Keep disabled in production. Set to 1 only for local demo registration when no SMS provider is configured.
MS_CAPTCHA_EXPOSE_CODE=0
GIN_MODE=release
ENABLE_PPROF=0

# Optional OpenAI-compatible weekly report provider.
MS_AI_PROVIDER=local
MS_AI_API_URL=
MS_AI_API_KEY=
MS_AI_MODEL=
MS_AI_TIMEOUT_SECONDS=20
