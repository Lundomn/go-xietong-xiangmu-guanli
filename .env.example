# Required for docker-compose.deploy.yaml. Use long random values in real deployments.
MS_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MS_MYSQL_USER=root
# When using the root account locally, keep this equal to MS_MYSQL_ROOT_PASSWORD.
MS_MYSQL_PASSWORD=replace-with-a-long-random-password
MS_MYSQL_DATABASE=msproject

MS_JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
MS_JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
MS_REDIS_PASSWORD=

# Keep disabled in production. Set to 1 only for local demo registration.
MS_CAPTCHA_EXPOSE_CODE=0

# Optional Tencent Cloud SMS provider for production registration/login codes.
# The approved signature and template must contain one variable for the code.
MS_SMS_PROVIDER=none
MS_SMS_SECRET_ID=
MS_SMS_SECRET_KEY=
MS_SMS_REGION=ap-guangzhou
MS_SMS_ENDPOINT=https://sms.tencentcloudapi.com
MS_SMS_SDK_APP_ID=
MS_SMS_SIGN_NAME=
MS_SMS_TEMPLATE_ID=
MS_SMS_COUNTRY_CODE=+86
MS_SMS_SESSION_CONTEXT=go-xietong-xiangmu-guanli
MS_SMS_TIMEOUT_SECONDS=8
GIN_MODE=release
ENABLE_PPROF=0

# Optional OpenAI-compatible weekly report provider.
MS_AI_PROVIDER=local
MS_AI_API_URL=
MS_AI_API_KEY=
MS_AI_MODEL=
MS_AI_TIMEOUT_SECONDS=20
